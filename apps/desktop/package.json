{
  "name": "@knowledge-desktop/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Knowledge Desktop — local KB + browser workbench",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/copy-assets.mjs",
    "preview": "electron-vite preview",
    "db:smoke": "tsx electron/db/smoke.ts",
    "vector:smoke": "tsx electron/ingest/vector-smoke.ts",
    "build:win": "pnpm build && electron-builder --win",
    "knowledge:smoke": "tsx electron/scripts/knowledge-smoke.ts"
  },
  "dependencies": {
    "@knowledge-desktop/shared": "workspace:*",
    "better-sqlite3": "^11.8.1",
    "jszip": "^3.10.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sqlite-vec": "^0.1.9",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.20.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.knowledge.desktop",
    "productName": "Knowledge Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron/db/schema.sql",
        "to": "schema.sql"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
